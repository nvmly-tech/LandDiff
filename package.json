{
  "name": "landdiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Почасовой мониторинг лендингов: детект изменений по DOM, скриншоты до/после с подсветкой, уведомления в почту и Telegram",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "check": "tsx src/cli.ts check",
    "baseline": "tsx src/cli.ts baseline",
    "list": "tsx src/cli.ts list",
    "test-mail": "tsx src/cli.ts test-mail",
    "test-telegram": "tsx src/cli.ts test-telegram",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "p-limit": "^7.1.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
