# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл .env в репозиторий не попадает — в нём секреты.

# ---------------------------------------------------------------- Telegram

# Токен бота от @BotFather кладётся одной строкой в secrets/telegram_token,
# а не сюда: .env целиком уходит в окружение контейнера, и значение было бы
# видно и в `docker inspect`, и в /proc/1/environ. Здесь остаётся только путь —
# он нужен для запуска на хосте; в контейнере docker-compose перекрывает его
# на /run/secrets/telegram_token.
#
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' '123456:AA...' > secrets/telegram_token && chmod 600 secrets/telegram_token
#
# Токен по-прежнему можно задать и напрямую через TELEGRAM_BOT_TOKEN — файл
# просто приоритетнее переменной.
TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_token

# Куда слать по умолчанию. Свой id можно узнать, написав боту @userinfobot.
# Для группы id отрицательный, например -1001234567890.
# Отдельному лендингу чат можно переопределить полем telegramChatId в landings.yaml.
TELEGRAM_CHAT_ID=

# Адрес Bot API. Менять нужно только при работе через собственный прокси.
# TELEGRAM_API_BASE=https://api.telegram.org

# ------------------------------------------------------------------- Почта

# Пример для Яндекса. Порт 465 — SSL сразу; для 587 (STARTTLS) поставьте
# SMTP_SECURE=false. Персональные ящики Outlook.com отправителем не годятся:
# Microsoft отключила авторизацию по паролю для SMTP.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true

# Полный адрес ящика, включая домен. Без логина и пароля канал считается
# ненастроенным и уведомления по почте не уходят.
SMTP_USER=

# Пароль приложения, а не пароль от аккаунта: id.yandex.ru → Безопасность →
# Пароли приложений → Почта. В настройках ящика ещё нужно включить доступ
# по протоколу IMAP: Почта → Настройки → Почтовые программы.
# Сам пароль — в secrets/smtp_pass, по тем же причинам, что и токен бота:
#
#   printf '%s' 'пароль-приложения' > secrets/smtp_pass && chmod 600 secrets/smtp_pass
SMTP_PASS_FILE=./secrets/smtp_pass

# От кого. Яндекс отвергает письма, если адрес отправителя не совпадает
# с ящиком, под которым вы авторизовались. Пусто — возьмётся SMTP_USER.
SMTP_FROM=

# ------------------------------------------------------------------ Прочее

# Сколько неудачных проверок подряд считать поломкой лендинга
# (1 — сообщать сразу). Защита от одиночных таймаутов.
NOTIFY_FAIL_THRESHOLD=3

# Расписание проверок в формате cron. Штатный режим — раз в час; на время
# обкатки удобно поставить */5 * * * *, но постоянно так держать не стоит:
# частый опрос множит шум на нестабильных площадках и нагружает чужой сайт.
# Расписание одно на всю службу: все лендинги ходят по нему.
# Изменение требует перезапуска контейнера, в отличие от landings.yaml.
CRON_SCHEDULE=0 * * * *

# Прогнать все лендинги сразу при старте, не дожидаясь ближайшего часа.
RUN_ON_START=true

# Сколько лендингов проверять одновременно.
CONCURRENCY=3

# Часовой пояс: влияет на время в уведомлениях и на расписание крона.
TZ=Europe/Moscow

# Уровень журнала: trace | debug | info | warn | error
LOG_LEVEL=info

# Разрешить в landings.yaml адреса file:// — только для отладки на локальных
# фикстурах. В боевом режиме держите выключенным: file:///proc/self/environ
# отрисовал бы секреты процесса в скриншот и разослал их уведомлением.
# ALLOW_FILE_URLS=1
